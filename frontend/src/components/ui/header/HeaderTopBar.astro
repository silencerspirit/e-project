---
import type { TSiteConfig } from '@contracts';
import { MapPin, Phone } from '@lucide/astro';

import { formatPhone } from '@/helpers';

interface Props {
  address?: TSiteConfig['address'];
  phone?: TSiteConfig['phone'];
}

const { phone, address } = Astro.props;
const telHref = `tel:${phone?.replace(/\D/g, '')}`;
---

<div class="bg-foreground text-card">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2 text-sm sm:px-6 lg:px-8">
    <div class="flex min-w-0 flex-1 items-center gap-2 pr-4">
      <MapPin class="h-4 w-4 shrink-0" />
      <span class="truncate">{address}</span>
    </div>

    <a
      href={telHref}
      class="flex shrink-0 items-center gap-2 transition-colors hover:text-primary"
    >
      <Phone class="h-4 w-4" />
      <span class="font-medium">{formatPhone(phone ?? '')}</span>
    </a>
  </div>
</div>
