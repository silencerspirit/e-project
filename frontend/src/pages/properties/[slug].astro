---
import { PropertySlugSchema } from '@contracts';
import { Check, MapPin } from 'lucide-vue-next';
import { parse } from 'valibot';

import { getSiteConfig } from '@/api';
import { getPropertyBySlug, getPropertySimilarBySlug } from '@/api';
import VPropertyDetailContact from '@/components/pages/properties/components/VPropertyDetailContact.vue';
import VPropertyDetailDescription from '@/components/pages/properties/components/VPropertyDetailDescription.vue';
import VPropertyDetailForm from '@/components/pages/properties/components/VPropertyDetailForm.vue';
import VPropertyDetailList from '@/components/pages/properties/components/VPropertyDetailList.vue';
import VPropertyDetailMap from '@/components/pages/properties/components/VPropertyDetailMap.vue';
import VPropertyDetailSimilar from '@/components/pages/properties/components/VPropertyDetailSimilar.vue';
import VPropertyDetailSlider from '@/components/pages/properties/components/VPropertyDetailSlider.vue';
import VPropertyDetailSpecification from '@/components/pages/properties/components/VPropertyDetailSpecification.vue';
import VPropertyDetailTechSpecification from '@/components/pages/properties/components/VPropertyDetailTechSpecification.vue';
import { isExistCoords } from '@/components/pages/properties/properties.utils';
import type { IBreadcrumbItem } from '@/components/vue/breadcrumbs';
import VBreadcrumbs from '@/components/vue/breadcrumbs/VBreadcrumbs.vue';
import { createBreadcrumbListSchema, createRealEstateListingSchema, getPublicSiteUrl } from '@/helpers';

import Layout from '@/layouts/Layout.astro';

const { slug } = parse(PropertySlugSchema, Astro.params);
const [property, { list: similarList }, config] = await Promise.all([
  getPropertyBySlug(slug),
  getPropertySimilarBySlug(slug),
  getSiteConfig(),
]);

const [badge = undefined] = property.badges;
const metaTitle: string = property.seo?.metaTitle ?? '';
const metaDescription: string = property.seo?.metaDescription ?? '';
const openGraphImage: string = property?.previewImage?.formats?.large ?? '';
const siteUrl = getPublicSiteUrl(Astro.url);
const pageUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();

const realEstateListingSchema = createRealEstateListingSchema(siteUrl, {
  property,
  pageUrl,
  metaDescription,
});

const breadcrumb: Required<IBreadcrumbItem> = { label: 'Аренда', href: '/properties/' };

const breadcrumbSchema = createBreadcrumbListSchema(siteUrl, [
  {
    position: 1,
    name: 'Главная',
    item: '/',
  },
  {
    position: 2,
    name: breadcrumb.label,
    item: breadcrumb.href,
  },
  {
    position: 3,
    name: property.title,
    item: pageUrl,
  },
]);
---

<Layout
  metaTitle={metaTitle}
  openGraphImage={openGraphImage}
  metaDescription={metaDescription}
  structuredData={[realEstateListingSchema, breadcrumbSchema]}
>
  <VBreadcrumbs
    items={[breadcrumb]}
    title={property.title}
    status={badge?.value}
    category={property.propertyType?.name}
    description={property.address}
  />

  <VPropertyDetailSlider
    client:load
    images={property.images}
  />

  <section class="py-12 lg:py-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-3 lg:gap-12 lg:px-8">
      <div class="flex flex-col gap-10 lg:col-span-2">
        <VPropertyDetailSpecification item={property} />

        {
          isExistCoords(property) && (
            <VPropertyDetailMap
              client:load
              item={property}
            />
          )
        }

        {property.description && <VPropertyDetailDescription item={property} />}

        {
          Boolean(property.activityTypes.length) && (
            <VPropertyDetailList
              list={property.activityTypes}
              title="Возможные виды деятельности"
              icon={Check}
            />
          )
        }

        {
          Boolean(property.infrastructure.length) && (
            <VPropertyDetailList
              list={property.infrastructure}
              title="Инфраструктура"
              icon={MapPin}
              inverse
            />
          )
        }
      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-36">
          <VPropertyDetailForm
            client:load
            title={property.title}
          />

          {
            Boolean(property.techSpecifications.length) && (
              <VPropertyDetailTechSpecification techSpecification={property.techSpecifications} />
            )
          }

          <VPropertyDetailContact config={config} />
        </div>
      </div>
    </div>
  </section>

  {
    Boolean(similarList.length) && (
      <VPropertyDetailSimilar
        client:load
        similarList={similarList}
      />
    )
  }
</Layout>
