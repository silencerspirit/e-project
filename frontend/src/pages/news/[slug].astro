---
import { NewsSlugSchema } from '@contracts';
import { parse } from 'valibot';

import { getNewsBySlug } from '@/api';

import SmartImage from '@/components/smart-image/SmartImage.astro';
import Breadcrumbs, { type IBreadcrumbItem } from '@/components/ui/breadcrumbs/Breadcrumbs.astro';
import Datetime from '@/components/ui/datetime/Datetime.astro';
import ShareButton from '@/components/ui/share-button/ShareButton.astro';
import Layout from '@/layouts/Layout.astro';

const { slug } = parse(NewsSlugSchema, Astro.params);
const newsItem = await getNewsBySlug(slug);

const metaTitle: string = newsItem.seo?.metaTitle ?? '';
const metaDescription: string = newsItem.seo?.metaDescription ?? '';
const openGraphImage: string = newsItem.image?.url ?? '';

const breadcrumbs: IBreadcrumbItem[] = [
  { label: 'Главная', link: '/' },
  { label: 'Новости', link: '/news/' },
  { label: newsItem.title },
];
---

<Layout
  withSidebar={false}
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  openGraphImage={openGraphImage}
>
  <Breadcrumbs
    slot="breadcrumbs"
    breadcrumbs={breadcrumbs}
  />
  <article>
    <div class="mb-pad-lg flex flex-col gap-grid-xs">
      <Datetime
        class="self-start"
        datetime={newsItem.publishedDate}
      />
      <h1 class="h1">{newsItem.title}</h1>
    </div>

    <SmartImage
      class="mb-pad-lg aspect-video"
      image={newsItem.image}
      fetchpriority={'high'}
      loading={'eager'}
    />

    <Fragment set:html={newsItem.content} />

    <ShareButton class:list={['mt-grid-md']} />
  </article>
</Layout>
