---

---

<form
  action="/search"
  role="search"
  aria-label="Поиск по сайту"
  class="flex gap-grid-xxs"
>
  <input
    type="text"
    name="q"
    id="header-search-input"
    maxlength="50"
    minlength="3"
    required
    pattern=".*\\S.*"
    class="h-sz-32 rounded border border-grey-soft pl-pad-xxs shadow-inner outline-none"
  />

  <button
    type="submit"
    class="h6 rounded bg-red px-pad-sm py-pad-xxs uppercase text-white transition-colors hover:bg-blue"
  >
    Поиск
  </button>
</form>
