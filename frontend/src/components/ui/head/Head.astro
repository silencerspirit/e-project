---
import { getPublicSiteUrl, toAbsoluteUrl } from '@/helpers';

interface Props {
  canonical?: string;
  description?: string;
  ogImage?: string;
  robots?: string;
  structuredData?: unknown[];
  title?: string;
}

const DEFAULT_TITLE = 'Default title';
const DEFAULT_DESCRIPTION = 'Default description';
const DEFAULT_OG_IMAGE = '';
const DEFAULT_ROBOTS = 'index,follow';
const siteUrl = getPublicSiteUrl(Astro.url);
const canonicalDefault = new URL(Astro.url.pathname, `${siteUrl}/`).toString();

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  ogImage = DEFAULT_OG_IMAGE,
  canonical = canonicalDefault,
  robots = DEFAULT_ROBOTS,
  structuredData = [],
} = Astro.props;

const absoluteOgImageUrl = toAbsoluteUrl(ogImage, `${siteUrl}/`);
---

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width"
  />
  <link
    rel="icon"
    type="image/png"
    href="/favicon-96x96.png"
    sizes="96x96"
  />
  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />
  <link
    rel="shortcut icon"
    href="/favicon.ico"
  />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/apple-touch-icon.png"
  />
  <link
    rel="manifest"
    href="/site.webmanifest"
  />
  <meta
    name="generator"
    content={Astro.generator}
  />

  <meta
    name="description"
    content={description}
  />
  <meta
    name="robots"
    content={robots}
  />
  <link
    rel="canonical"
    href={canonical}
  />

  <meta
    property="og:title"
    content={title}
  />
  <meta
    property="og:description"
    content={description}
  />
  <meta
    property="og:type"
    content="website"
  />
  <meta
    property="og:url"
    content={canonical}
  />
  <meta
    property="og:site_name"
    content="Alfa realting"
  />
  {
    absoluteOgImageUrl && (
      <>
        <meta
          property="og:image:type"
          content="image/jpg"
        />
        <meta
          property="og:image:width"
          content="1000"
        />
        <meta
          property="og:image:height"
          content="1000"
        />
        <meta
          property="og:image"
          content={absoluteOgImageUrl}
        />
        <meta
          property="og:image:secure_url"
          content={absoluteOgImageUrl}
        />
      </>
    )
  }

  <title>{title}</title>
  <!-- Yandex.Metrika counter -->
  <script is:inline type="text/javascript">
    (function (m, e, t, r, i, k, a) {
      m[i] =
        m[i] ||
        function () {
          (m[i].a = m[i].a || []).push(arguments);
        };
      m[i].l = 1 * new Date();
      for (var j = 0; j < document.scripts.length; j++) {
        if (document.scripts[j].src === r) {
          return;
        }
      }
      ((k = e.createElement(t)),
        (a = e.getElementsByTagName(t)[0]),
        (k.async = 1),
        (k.src = r),
        a.parentNode.insertBefore(k, a));
    })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=109738417', 'ym');

    window.ym(109738417, 'init', {
      ssr: true,
      webvisor: true,
      clickmap: true,
      ecommerce: 'dataLayer',
      referrer: document.referrer,
      url: location.href,
      accurateTrackBounce: true,
      trackLinks: true,
    });
  </script>
  <noscript>
    <div>
      <img
        src="https://mc.yandex.ru/watch/109738417"
        style="position:absolute; left:-9999px;"
        alt=""
      />
    </div>
  </noscript>
  <!-- /Yandex.Metrika counter -->
  {
    structuredData.map((item) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(item)}
      />
    ))
  }
</head>
