---
import type { THeroBanner, TMainPageForm } from '@contracts';

import MainPageForm from '@/components/pages/index/MainPageForm.astro';
import SmartImage from '@/components/ui/smart-image/SmartImage.astro';

interface Props {
  info: THeroBanner;
  form: TMainPageForm;
}

const { info, form } = Astro.props;

const isExistMetrics: boolean = Boolean(info.metrics.length);
---

<section
  class="relative flex items-center"
  aria-labelledby="main-banner-title"
>
  <div class="absolute inset-0 z-0">
    <SmartImage
      class="h-full w-full object-cover"
      image={info.backgroundImage}
      fetchpriority={'high'}
      loading={'eager'}
    />
    <div class="absolute inset-0 bg-gradient-to-r from-foreground/85 via-foreground/65 to-foreground/45"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h1
        id="main-banner-title"
        class="text-balance text-4xl font-bold leading-tight text-card sm:text-5xl lg:text-6xl"
      >
        {info.title}
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-card/80 sm:text-xl">
        {info.description}
      </p>

      <MainPageForm form={form} />

      {
        isExistMetrics ? (
          <div class="mt-10 flex flex-wrap gap-8 lg:gap-12">
            {info.metrics.map(({ label, value }) => (
              <div>
                <div class="text-3xl font-bold text-card sm:text-4xl">{value}</div>
                <div class="mt-1 text-sm text-card/70">{label}</div>
              </div>
            ))}
          </div>
        ) : undefined
      }
    </div>
  </div>
</section>
