---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const DEFAULT_TITLE = 'Default title';
const DEFAULT_DESCRIPTION = 'Default description';
const DEFAULT_OG_IMAGE = '';

const { title = DEFAULT_TITLE, description = DEFAULT_DESCRIPTION, ogImage = DEFAULT_OG_IMAGE } = Astro.props as Props;
---

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width"
  />
  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />
  <link
    rel="icon"
    href="/favicon.ico"
  />
  <meta
    name="generator"
    content={Astro.generator}
  />

  <meta
    name="description"
    content={description}
  />

  <meta
    property="og:title"
    content={title}
  />
  <meta
    property="og:description"
    content={description}
  />
  <meta
    property="og:type"
    content="website"
  />
  <meta
    property="og:url"
    content={Astro.url}
  />
  <meta
    property="og:site_name"
    content="Alfa realting"
  />
  <meta
    property="og:image:type"
    content="image/jpg"
  />
  <meta
    property="og:image:width"
    content="1000"
  />
  <meta
    property="og:image:height"
    content="1000"
  />
  <meta
    property="og:image"
    content={ogImage}
  />
  <meta
    property="og:image:secure_url"
    content={ogImage}
  />

  <title>{title}</title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Overpass:wght@200;400;600;700&display=swap"
    rel="stylesheet"
  />
</head>
