---
import LogoIcon from '@/assets/logo.svg';

interface Props {
  invert?: boolean;
}

const { invert = false } = Astro.props;
---

<a
  href="/"
  class="flex items-center gap-3"
>
  <span
    class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-xl font-bold text-primary-foreground"
  >
    <LogoIcon class="h-6 w-6" />
  </span>

  <span class="hidden sm:block">
    <span
      class="block text-lg font-bold"
      class:list={{
        'leading-tight': invert,
        'text-foreground': !invert,
      }}
      >Альфа Риэлтинг</span
    >
    <span
      class="block text-xs"
      class:list={{
        'text-card/60': invert,
        'text-muted-foreground': !invert,
      }}
    >
      АльфаГруппИнвест
    </span>
  </span>
</a>
