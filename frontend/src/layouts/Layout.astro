---
import { getMenu, getSiteConfig } from '@/api';

import Footer from '@/components/ui/footer/Footer.astro';
import Head from '@/components/ui/head/Head.astro';
import Header from '@/components/ui/header/Header.astro';

import '@/styles/global.scss';

interface Props {
  withSidebar?: boolean;
  metaTitle?: string;
  metaDescription?: string;
  openGraphImage?: string;
}

const { metaTitle, metaDescription, openGraphImage } = Astro.props as Props;

const [{ header }, config] = await Promise.all([getMenu(), getSiteConfig()]);
---

<!doctype html>
<html lang="ru">
  <Head
    title={metaTitle}
    description={metaDescription}
    ogImage={openGraphImage}
  />

  <body>
    <Header
      menu={header}
      config={config}
    />

    <main class="grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
