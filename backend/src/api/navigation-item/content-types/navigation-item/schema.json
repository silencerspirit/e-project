{
  "kind": "collectionType",
  "collectionName": "navigation_items",
  "info": {
    "singularName": "navigation-item",
    "pluralName": "navigation-items",
    "displayName": "NavigationItem"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 1
    },
    "visible": {
      "type": "boolean",
      "default": true
    },
    "position": {
      "type": "enumeration",
      "required": true,
      "default": "header",
      "enum": [
        "header",
        "footer-first-column",
        "footer-second-column"
      ]
    }
  }
}
