---
import { SpecItemType, type TPropertyListItem } from '@contracts';
import { ArrowRight, CircleAlert, MapPin } from '@lucide/astro';

import { PRICE_PER_M2_SUFFIX, PRICE_SUFFIX } from '@/constants';
import { formatPrice } from '@/helpers';

import SmartImage from '@/components/ui/smart-image/SmartImage.astro';

import { PROPERTY_MODIFY_SELECTOR } from './property-card.consts';
import { SPEC_ICON_MAP } from './property-card.icons';

interface Props {
  property: TPropertyListItem;
  hideDetails?: boolean;
  fullPrice?: boolean;
  row?: boolean;
}

const { property, hideDetails = false, fullPrice = false, row = false, ...attributes } = Astro.props;
---

<li
  class="property-card h-full w-full"
  class:list={{
    [PROPERTY_MODIFY_SELECTOR]: row,
  }}
  data-listing-card
  {...attributes}
>
  <a
    href={`/properties/${property.slug}/`}
    class="property-card__item group flex h-full overflow-hidden rounded-2xl bg-card shadow-md transition-all duration-300 hover:border-primary/30 hover:shadow-xl"
  >
    <div class="property-card__image-container relative shrink-0 overflow-hidden">
      <SmartImage
        image={property.previewImage}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />

      <div class="absolute left-4 top-4">
        <span class="rounded-full bg-primary px-3 py-1 text-xs font-medium text-primary-foreground">
          {property.badges[0]?.value ?? ''}
        </span>
      </div>
    </div>

    <div class="flex grow flex-col p-6">
      <h3 class="text-xl font-semibold text-foreground transition-colors group-hover:text-primary">
        {property.title}
      </h3>

      <div class="mt-2 flex items-center gap-2 text-muted-foreground">
        <MapPin
          aria-hidden="true"
          class="h-4 w-4"
        />
        <span class="text-sm">{property.address}</span>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-4 pb-6 text-sm text-foreground/70">
        {
          property.specifications.slice(0, 2).map((spec) => {
            const Icon = SPEC_ICON_MAP[spec.key as SpecItemType] ?? CircleAlert;

            return (
              <div class="flex items-center gap-1.5">
                <Icon
                  aria-hidden="true"
                  class="h-4 w-4"
                />
                <span>
                  {spec.label}: {spec.value}
                </span>
              </div>
            );
          })
        }

        <p class="property-card__short-description line-clamp-2">
          {property.shortDescription}
        </p>
      </div>

      <div class="mt-auto flex items-center justify-between border-t border-border pt-4">
        <div class="text-xl font-bold text-primary">
          {
            fullPrice
              ? `от ${formatPrice(property.priceFrom)} ${PRICE_SUFFIX}`
              : `от ${formatPrice(property.pricePerM2)} ${PRICE_PER_M2_SUFFIX}`
          }
        </div>

        {
          !hideDetails && (
            <span class="inline-flex h-8 items-center gap-1 rounded-md px-3 text-sm text-primary transition-colors group-hover:bg-primary/10">
              Подробнее
              <ArrowRight
                aria-hidden="true"
                class="h-4 w-4"
              />
            </span>
          )
        }
      </div>
    </div>
  </a>
</li>

<style lang="scss">
  .property-card {
    $p: &;

    &--row {
      min-height: 256px;
    }

    &__image-container {
      @apply aspect-video;

      #{$p}--row & {
        @apply aspect-square;
      }
    }

    &__item {
      @apply flex-col;

      #{$p}--row & {
        @apply flex-row;
      }
    }

    &__short-description {
      &:not(#{$p}--row &) {
        @apply hidden;
      }
    }
  }
</style>
