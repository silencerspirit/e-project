---
import type { TNavigationItem } from '@contracts';
import { ExternalLink } from '@lucide/astro';
interface Props {
  class?: string;
  items: TNavigationItem[];
  mobile?: boolean;
}
import { isExternalLink } from '@/helpers';
const { items, class: className, mobile = false } = Astro.props;

const navClass = mobile ? 'flex flex-col gap-4' : 'hidden items-center gap-8 lg:flex';
---

<nav
  class:list={[navClass, className]}
  aria-label="Навигация"
>
  {
    items.map((item) => (
      <a
        href={item.url}
        class="inline-flex items-center gap-1 font-medium text-foreground/80 transition-colors hover:text-primary"
        class:list={{
          'text-sm': !mobile,
          'text-base': mobile,
        }}
        {...(isExternalLink(item.url) && { target: '_blank' })}
        {...(mobile && { 'data-mobile-menu-link': '' })}
      >
        {item.title}

        {isExternalLink(item.url) && <ExternalLink class="h-4 w-4" />}
      </a>
    ))
  }
</nav>
