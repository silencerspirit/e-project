---
import type { TNavigationItem, TSiteConfig } from '@contracts';
import { Menu, X } from '@lucide/astro';

import VButton from '@/components/vue/button/VButton.vue';

import HeaderLogo from './HeaderLogo.astro';
import HeaderNav from './HeaderNav.astro';
import HeaderTopBar from './HeaderTopBar.astro';

interface Props {
  config: TSiteConfig;
  menu: TNavigationItem[];
}

const { menu, config } = Astro.props;
const requestFormHref = '/#form';
---

<header class="header sticky top-0 z-50 border-b border-border bg-card/95 backdrop-blur-sm">
  <HeaderTopBar
    phone={config.phone}
    address={config.address}
  />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between lg:h-20">
      <HeaderLogo />
      <HeaderNav items={menu} />

      <div class="hidden lg:block">
        <VButton
          tag="a"
          href={requestFormHref}
        >
          Оставить заявку
        </VButton>
      </div>

      <button
        type="button"
        class="p-2 lg:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <Menu
          class="h-6 w-6 text-foreground"
          data-menu-icon
        />
        <X
          class="hidden h-6 w-6 text-foreground"
          data-close-icon
        />
      </button>
    </div>

    <div
      class="hidden border-t border-border py-4 lg:hidden"
      data-mobile-menu
      hidden
    >
      <div class="flex flex-col gap-4">
        <HeaderNav
          items={menu}
          mobile
        />

        <VButton
          tag="a"
          href={requestFormHref}
        >
          Оставить заявку
        </VButton>
      </div>
    </div>
  </div>
</header>

<script src="./header.ts"></script>

<style lang="scss">
  .header {
    z-index: 1001;
  }
</style>
