---
import { getMenu, getNewsNewest, getSiteConfig } from '@/api';
import '@/styles/global.scss';
import Header from '@/components/header/Header.astro';
import Footer from '@/components/Footer.astro';
import NewsLatest from '@/components/NewsLatest.astro';
import Head from '@/components/head/Head.astro';

interface Props {
  withSidebar?: boolean;
  metaTitle?: string;
  metaDescription?: string;
  openGraphImage?: string;
}

const { withSidebar = true, metaTitle, metaDescription, openGraphImage } = Astro.props as Props;

const [{ header }, config, news] = await Promise.all([
  getMenu(),
  getSiteConfig(),
  withSidebar ? getNewsNewest() : Promise.resolve({ list: [] }),
]);

const isExistNewsList = news.list.length > 0;
---

<!doctype html>
<html lang="ru">
  <Head
    title={metaTitle}
    description={metaDescription}
    ogImage={openGraphImage}
  />

  <body class="ui-container shadow-lg">
    <Header
      menu={header}
      config={config}
    />
    <main class="my-pad-md grid grow grid-cols-12 gap-grid-sm rounded py-pad-sm">
      {
        isExistNewsList && (
          <NewsLatest
            class="col-span-4"
            list={news.list}
          />
        )
      }
      <div class={isExistNewsList ? 'col-span-8' : 'col-span-12'}>
        <slot />
      </div>
    </main>

    <Footer menu={header} />
  </body>
</html>
