---
import type { TNavigationItem } from '@backend/contracts';

import TriangleRightIcon from '@/assets/triangle-right.svg';

interface Props {
  item: TNavigationItem;
  inner?: boolean;
  last?: boolean;
}

const { item, inner = false, last = false } = Astro.props as Props;
const hasChildren = Array.isArray(item.children) && item.children.length > 0;
const isExternal = (url?: string) => typeof url === 'string' && /^https?:\/\//.test(url);
---

<li
  class="group relative"
  class:list={{
    flex: hasChildren,
    'border-b border-grey-dark': !last && inner,
  }}
>
  {hasChildren ? <TriangleRightIcon class="my-auto h-sz-14 text-red" /> : undefined}

  {
    item.url ? (
      <a
        href={item.url}
        class="focus-visible:ui-focus caption inline-flex w-full items-center transition-colors hover:text-red"
        class:list={{
          'px-pad-sm py-pad-xxs text-grey-soft': inner,
        }}
        target={isExternal(item.url) ? '_blank' : undefined}
        rel={isExternal(item.url) ? 'noopener noreferrer' : undefined}
        aria-haspopup={hasChildren ? 'menu' : undefined}
      >
        {item.title}
      </a>
    ) : (
      <span
        class="inline-flex"
        aria-haspopup={hasChildren ? 'menu' : undefined}
      >
        {item.title}
      </span>
    )
  }

  {
    hasChildren ? (
      <div class="invisible absolute left-0 top-full opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
        <ul
          class="translate-y-1 whitespace-nowrap rounded bg-black transition hover:visible hover:opacity-100 group-focus-within:translate-y-0"
          role="menu"
        >
          {item.children.map((child, index) => {
            const isLast = index === item.children.length - 1;

            return (
              <Astro.self
                item={child}
                last={isLast}
                inner
              />
            );
          })}
        </ul>
      </div>
    ) : null
  }
</li>
