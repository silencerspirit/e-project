---
import { getPersonalDataPage } from '@/api';
import VBreadcrumbs from '@/components/vue/breadcrumbs/VBreadcrumbs.vue';

import Content from '@/components/ui/content/Content.astro';
import Layout from '@/layouts/Layout.astro';

const page = await getPersonalDataPage();

const metaTitle: string = page.seo?.metaTitle ?? '';
const metaDescription: string = page.seo?.metaDescription ?? '';
---

<Layout
  metaTitle={metaTitle}
  metaDescription={metaDescription}
>
  <VBreadcrumbs title={page.title} />

  <section class="py-12 lg:py-16">
    <Content
      class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8"
      content={page.content}
    />
  </section>
</Layout>
