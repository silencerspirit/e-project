---
import { getMenu } from '@/api';
import '@/styles/global.scss';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const { header, footer } = await getMenu();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="icon"
      href="/favicon.ico"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>Astro Basics</title>
  </head>
  <body>
    <Header menu={header} />
    <slot />
    <Footer menu={footer} />
  </body>
</html>
