---
import { PropertySlugSchema } from '@contracts';
import { Check, MapPin } from '@lucide/astro';
import { parse } from 'valibot';

import { getSiteConfig } from '@/api';
import { getPropertyBySlug, getPropertySimilarBySlug } from '@/api';
import type { TBreadcrumbItem } from '@/components/ui/breadcrumbs/Breadcrumbs.astro';
import { createBreadcrumbListSchema, createRealEstateListingSchema, getPublicSiteUrl } from '@/helpers';

import PropertyDetailContact from '@/components/pages/properties/components/PropertyDetailContact.astro';
import PropertyDetailDescription from '@/components/pages/properties/components/PropertyDetailDescription.astro';
import PropertyDetailForm from '@/components/pages/properties/components/PropertyDetailForm.astro';
import PropertyDetailList from '@/components/pages/properties/components/PropertyDetailList.astro';
import PropertyDetailSimilar from '@/components/pages/properties/components/PropertyDetailSimilar.astro';
import PropertyDetailSlider from '@/components/pages/properties/components/PropertyDetailSlider.astro';
import PropertyDetailSpecification from '@/components/pages/properties/components/PropertyDetailSpecification.astro';
import PropertyDetailTechSpecification from '@/components/pages/properties/components/PropertyDetailTechSpecification.astro';
import Breadcrumbs from '@/components/ui/breadcrumbs/Breadcrumbs.astro';
import Layout from '@/layouts/Layout.astro';

const { slug } = parse(PropertySlugSchema, Astro.params);
const [property, { list: similarList }, config] = await Promise.all([
  getPropertyBySlug(slug),
  getPropertySimilarBySlug(slug),
  getSiteConfig(),
]);

const [badge = undefined] = property.badges;
const metaTitle: string = property.seo?.metaTitle ?? '';
const metaDescription: string = property.seo?.metaDescription ?? '';
const openGraphImage: string = property?.previewImage?.formats?.large ?? '';
const siteUrl = getPublicSiteUrl(Astro.url);
const pageUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();

const realEstateListingSchema = createRealEstateListingSchema(siteUrl, {
  property,
  pageUrl,
  metaDescription,
});

const breadcrumb: Required<TBreadcrumbItem> = { label: 'Аренда', href: '/properties/' };

const breadcrumbSchema = createBreadcrumbListSchema(siteUrl, [
  {
    position: 1,
    name: 'Главная',
    item: '/',
  },
  {
    position: 2,
    name: breadcrumb.label,
    item: breadcrumb.href,
  },
  {
    position: 3,
    name: property.title,
    item: pageUrl,
  },
]);
---

<Layout
  metaTitle={metaTitle}
  openGraphImage={openGraphImage}
  metaDescription={metaDescription}
  structuredData={[realEstateListingSchema, breadcrumbSchema]}
>
  <Breadcrumbs
    items={[breadcrumb]}
    title={property.title}
    status={badge?.value}
    category={property.propertyType?.name}
    description={property.address}
  />

  <PropertyDetailSlider images={property.images} />

  <section class="py-12 lg:py-16">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-3 lg:gap-12 lg:px-8">
      <div class="flex flex-col gap-10 lg:col-span-2">
        <PropertyDetailSpecification property={property} />

        {property.description && <PropertyDetailDescription property={property} />}

        {
          Boolean(property.activityTypes.length) && (
            <PropertyDetailList
              list={property.activityTypes}
              title="Возможные виды деятельности"
              icon={Check}
            />
          )
        }

        {
          Boolean(property.infrastructure.length) && (
            <PropertyDetailList
              list={property.infrastructure}
              title="Инфраструктура"
              icon={MapPin}
              inverse
            />
          )
        }
      </div>

      <div class="lg:col-span-1">
        <div class="sticky top-36">
          <PropertyDetailForm title={property.title} />

          {
            Boolean(property.techSpecifications.length) && (
              <PropertyDetailTechSpecification techSpecification={property.techSpecifications} />
            )
          }

          <PropertyDetailContact config={config} />
        </div>
      </div>
    </div>
  </section>

  {Boolean(similarList.length) && <PropertyDetailSimilar similarList={similarList} />}
</Layout>
