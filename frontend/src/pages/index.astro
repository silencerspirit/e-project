---
import { getMainPage, getMainPageForm } from '@/api';
import { createOrganizationSchema, createWebSiteSchema, getPublicSiteUrl } from '@/helpers';

import MainPageAction from '@/components/pages/index/MainPageAction.astro';
import MainPageAdvantages from '@/components/pages/index/MainPageAdvantages.astro';
import MainPageBanner from '@/components/pages/index/MainPageBanner.astro';
import MainPageCategories from '@/components/pages/index/MainPageCategories.astro';
import MainPageListing from '@/components/pages/index/MainPageListing.astro';
import Layout from '@/layouts/Layout.astro';

const [page, form] = await Promise.all([getMainPage(), getMainPageForm()]);

const metaTitle: string = page.seo?.metaTitle ?? '';
const metaDescription: string = page.seo?.metaDescription ?? '';
const siteUrl = getPublicSiteUrl(Astro.url);
const organizationSchema = createOrganizationSchema(siteUrl);
const webSiteSchema = createWebSiteSchema(siteUrl);
---

<Layout
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  structuredData={[organizationSchema, webSiteSchema]}
>
  <MainPageBanner
    info={page.heroBanner}
    form={form}
  />
  <MainPageCategories info={page.featureBanner} />
  <MainPageListing info={page.showcaseBanner} />
  <MainPageAdvantages info={page.advantagesBanner} />
  <MainPageAction />
</Layout>
