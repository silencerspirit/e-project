---
import type { TNavigationItem, TSiteConfig } from '@backend/contracts';
import MobileIcon from '@/assets/mobile.svg';
import { formatPhone } from '@/helpers';
import { Image } from 'astro:assets';
import HeaderItem from './HeaderItem.astro';
import HeaderSearch from './HeaderSearch.astro';

interface Props {
  menu: TNavigationItem[];
  config: TSiteConfig;
}

const { menu, config } = Astro.props as Props;
---

<header class="header flex flex-col">
  <div class="mb-grid-sm flex justify-between pt-pad-sm">
    <a href="/">
      <Image
        src="/images/logo.png"
        width={329}
        height={60}
        alt="Альфа Риэлтинг"
      />
    </a>

    <div class="flex flex-col gap-grid-sm">
      <div class="flex items-center justify-end gap-grid-3xs">
        <MobileIcon class="h-sz-20 min-w-sz-20 text-blue" />
        <a
          href={`tel:${config.phone}`}
          class="light-title whitespace-nowrap pt-pad-3xs text-grey-dark transition-colors hover:text-red"
        >
          {formatPhone(config.phone)}
        </a>
      </div>

      <HeaderSearch />
    </div>
  </div>

  <nav>
    <ul class="flex w-full justify-end gap-grid-xs text-green">
      {menu.map((item) => <HeaderItem item={item} />)}
    </ul>
  </nav>
</header>
