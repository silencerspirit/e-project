---
import { getMainPage, getMainPageForm } from '@/api';
import VMainPageAdvantages from '@/components/pages/index/VMainPageAdvantages.vue';
import VMainPageBanner from '@/components/pages/index/VMainPageBanner.vue';
import VMainPageCategories from '@/components/pages/index/VMainPageCategories.vue';
import VMainPageListing from '@/components/pages/index/VMainPageListing.vue';
import VRequestSection from '@/components/vue/VRequestSection.vue';
import { createOrganizationSchema, createWebSiteSchema, getPublicSiteUrl } from '@/helpers';

import Layout from '@/layouts/Layout.astro';

const [page, form] = await Promise.all([getMainPage(), getMainPageForm()]);

const metaTitle: string = page.seo?.metaTitle ?? '';
const metaDescription: string = page.seo?.metaDescription ?? '';
const siteUrl = getPublicSiteUrl(Astro.url);
const organizationSchema = createOrganizationSchema(siteUrl);
const webSiteSchema = createWebSiteSchema(siteUrl);
---

<Layout
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  structuredData={[organizationSchema, webSiteSchema]}
>
  {
    page.heroBanner && (
      <VMainPageBanner
        client:load
        info={page.heroBanner}
        form={form}
      />
    )
  }

  {page.featureBanner && <VMainPageCategories info={page.featureBanner} />}

  {
    page.showcaseBanner && (
      <VMainPageListing
        client:visible
        info={page.showcaseBanner}
      />
    )
  }

  {page.advantagesBanner && <VMainPageAdvantages info={page.advantagesBanner} />}

  {
    page.requestBanner && (
      <VRequestSection
        id="form"
        info={page.requestBanner}
        client:visible
      />
    )
  }
</Layout>
