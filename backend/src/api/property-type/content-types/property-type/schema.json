{
  "kind": "collectionType",
  "collectionName": "property_types",
  "info": {
    "singularName": "property-type",
    "pluralName": "property-types",
    "displayName": "PropertyType"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "properties": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::property.property",
      "mappedBy": "propertyType"
    }
  }
}
