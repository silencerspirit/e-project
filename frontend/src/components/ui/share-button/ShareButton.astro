---
import Button from '@/components/ui/button/Button.astro';
import { SocialShareIcon } from '@/assets/icons';
import type { JSX } from 'astro/jsx-runtime';

const { class: className } = Astro.props as JSX.ButtonHTMLAttributes;

const classes = ['share-button flex items-center gap-grid-xxs', className].filter(Boolean).join(' ');
---

<Button
  class={classes}
  type="button"
  data-share-button
  data-text="Поделиться"
>
  <SocialShareIcon class="h-sz-12 w-sz-12" />
</Button>

<style lang="scss">
  .share-button {
    &:before {
      content: attr(data-text);
    }
  }
</style>

<script src="./share-button.ts"></script>
