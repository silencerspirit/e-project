---
import { MenuPosition, type TMenu, type TSiteConfig } from '@contracts';
import { Clock, ExternalLink, Mail, MapPin, Phone } from '@lucide/astro';

import { formatPhone, isExternalLink } from '@/helpers';

import HeaderLogo from '@/components/ui/header/HeaderLogo.astro';

interface Props {
  config: TSiteConfig;
  menu: TMenu;
}

const { config, menu } = Astro.props;
const footerSections = [
  {
    title: 'Недвижимость',
    links: menu[MenuPosition.FooterFirstColumn],
  },
  {
    title: 'Компания',
    links: menu[MenuPosition.FooterSecondColumn],
  },
];
const year = new Date().getFullYear();
---

<footer class="bg-foreground text-card">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div class="lg:col-span-2">
        <HeaderLogo invert />

        <p class="mt-6 max-w-xs text-sm leading-relaxed text-card/70">
          Надежный застройщик с 15-летним опытом строительства жилых комплексов в Крыму
        </p>

        <div class="mt-6 flex flex-col items-start space-y-3">
          {
            config.phone && (
              <a
                href={`tel:${config.phone}`}
                class="flex items-center gap-3 text-card/80 transition-colors hover:text-primary"
              >
                <Phone class="h-4 w-4" />
                <span class="text-sm">{formatPhone(config.phone)}</span>
              </a>
            )
          }

          {
            config.additionalPhone && (
              <a
                href={`tel:${config.additionalPhone}`}
                class="flex items-center gap-3 text-card/80 transition-colors hover:text-primary"
              >
                <Phone class="h-4 w-4" />
                <span class="text-sm">{formatPhone(config.additionalPhone)}</span>
              </a>
            )
          }

          {
            config.email && (
              <a
                href={`mailto:${config.email}`}
                class="flex items-center gap-3 text-card/80 transition-colors hover:text-primary"
              >
                <Mail class="h-4 w-4" />
                <span class="text-sm">{config.email}</span>
              </a>
            )
          }

          {
            config.address && (
              <div class="flex items-start gap-3 text-card/80">
                <MapPin class="mt-0.5 h-4 w-4" />
                <span class="text-sm">{config.address}</span>
              </div>
            )
          }

          {
            config.workTime && (
              <div class="flex items-center gap-3 text-card/80">
                <Clock class="h-4 w-4" />
                <span class="text-sm">{config.workTime ?? ''}</span>
              </div>
            )
          }
        </div>
      </div>

      {
        footerSections.map((section) => (
          <nav aria-label={section.title}>
            <h4 class="mb-4 text-sm font-semibold">{section.title}</h4>
            <ul class="space-y-2.5">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.url}
                    class="inline-flex items-center gap-2 text-sm text-card/70 transition-colors hover:text-primary"
                    {...(isExternalLink(link.url) && { target: '_blank' })}
                  >
                    {link.title}

                    {isExternalLink(link.url) && <ExternalLink class="h-4 w-4" />}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-14 border-t border-card/10 pt-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-card/60">© {year} АЛЬФАГРУППИНВЕСТ. Все права защищены.</p>
        <div class="flex items-center gap-6">
          <a
            href="/privacy-policy/"
            class="text-sm text-card/60 transition-colors hover:text-card"
          >
            Политика конфиденциальности
          </a>
          <a
            href="/personal-data/"
            class="text-sm text-card/60 transition-colors hover:text-card"
          >
            Согласие на обработку данных
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
