{
  "name": "e-project-monorepo",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "npx concurrently -n backend,frontend -c blue,green \"npm run develop --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix backend && npm run build --prefix frontend",
    "start": "npx concurrently -n backend,frontend -c blue,green \"npm run start --prefix backend\" \"npm run start --prefix frontend\"",
    "docker:build:prod": "./scripts/build-dockerhub.sh",
    "docker:push:prod": "./scripts/push-dockerhub.sh",
    "docker:release:prod": "./scripts/build-and-push-dockerhub.sh",
    "db:backup": "./scripts/backup-db.sh",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "pre-commit": "lint-staged",
    "typecheck": "tsc -p backend/tsconfig.json --noEmit && npm run check --prefix frontend",
    "prepare": "husky",
    "preinstall": "node -e \"const major=Number(process.versions.node.split('.')[0]); if (major<22){console.error('Node 22+ required. Current: '+process.versions.node); process.exit(1)}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "astro-eslint-parser": "^1.1.1",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^1.2.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "5.5.4",
    "vue-eslint-parser": "^10.4.0"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.8.2",
  "overrides": {
    "typescript": "5.5.4"
  }
}
