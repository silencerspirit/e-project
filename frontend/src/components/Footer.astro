---
import type { TNavigationItem } from '@contracts';

interface Props {
  menu: TNavigationItem[];
}

const { menu } = Astro.props;
---

<footer class="footer negative-x-margin shadow-lg">
  <div class="flex justify-between bg-blue px-pad-sm py-pad-md text-white">
    {
      menu.map((item) => (
        <ul>
          <li>
            <a
              class="h4 transition-colors hover:text-red"
              href={`${item.url}`}
            >
              {item.title}
            </a>
          </li>

          {item.children.length > 0 ? (
            <li>
              <ul>
                {item.children.map((subitem) => (
                  <li class="pl-pad-3xs">
                    <a
                      class="h5 transition-colors hover:text-red"
                      href="#"
                    >
                      {subitem.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : undefined}
        </ul>
      ))
    }
  </div>

  <div class="h4 px-pad-sm py-pad-xs">
    Альфа Риэлтинг © {new Date().getFullYear()}
  </div>
</footer>
