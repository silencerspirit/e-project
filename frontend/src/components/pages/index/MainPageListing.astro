---
import type { TShowcaseBanner } from '@contracts';
import { ArrowRight } from '@lucide/astro';

import Button from '@/components/ui/button/Button.astro';
import PropertyCard from '@/components/ui/property-card/PropertyCard.astro';

interface Props {
  info: TShowcaseBanner;
}

const { info } = Astro.props;

const sectionId = `main-page-listings-${Math.random().toString(36).slice(2)}`;

const propertyTypes: string[] = [
  ...new Set(info.properties.map((property) => property.propertyType?.name ?? '').filter(Boolean)),
];
const DEFAULT_FILTER_VALUE = 'Все';
const filters = [DEFAULT_FILTER_VALUE, ...propertyTypes] as const;
---

<section
  id={sectionId}
  class="bg-background py-20 lg:py-28"
  aria-labelledby="main-page-listings-title"
  data-main-page-listing
  data-default-filter-value={DEFAULT_FILTER_VALUE}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2
          id="main-page-listings-title"
          class="text-balance text-3xl font-bold text-foreground sm:text-4xl"
        >
          {info.title}
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">{info.description}</p>
      </div>

      <div
        class="flex flex-wrap gap-2"
        role="group"
        aria-label="Фильтр объектов по типу"
      >
        {
          filters.map((filter) => (
            <Button
              data-listing-filter
              data-filter={filter}
              data-active={DEFAULT_FILTER_VALUE}
              aria-pressed={filter === DEFAULT_FILTER_VALUE ? 'true' : 'false'}
              data-all={filter === DEFAULT_FILTER_VALUE ? '' : undefined}
              class:list={[
                'rounded-full',
                { 'bg-primary text-primary-foreground': filter === DEFAULT_FILTER_VALUE },
                { 'bg-secondary text-foreground hover:bg-secondary': filter !== DEFAULT_FILTER_VALUE },
              ]}
            >
              {filter}
            </Button>
          ))
        }
      </div>
    </div>

    <ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        info.properties.map((property) => (
          <PropertyCard
            property={property}
            data-type={property.propertyType?.name}
          />
        ))
      }
    </ul>

    <div class="mt-12 text-center">
      <Button
        href="/properties/"
        variant="outline"
        size="lg"
        class="border-primary bg-transparent text-primary hover:bg-primary hover:text-primary-foreground"
      >
        Смотреть все объекты
        <ArrowRight
          aria-hidden="true"
          class="h-4 w-4"
        />
      </Button>
    </div>
  </div>
</section>

<script src="./main-page-listing.ts"></script>
