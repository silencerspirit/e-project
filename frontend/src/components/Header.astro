---
import type { TNavigationItem } from '@contracts/menu';

interface Props {
  menu: TNavigationItem[];
}

const { menu } = Astro.props as Props;
---

<header class="sticky top-0 z-20 border-b border-black/10 bg-white/90 backdrop-blur">
  <nav
    class="mx-auto max-w-6xl px-4 py-3"
    aria-label="Main"
  >
    <ul class="flex flex-wrap items-center gap-5">
      {
        menu.map((item) => (
          <li class="group relative">
            {item.url ? (
              <a
                href={item.url}
                class="inline-flex items-center gap-2 rounded-lg px-2.5 py-2 text-sm font-semibold text-slate-900 transition hover:bg-slate-900/5"
              >
                {item.title}
              </a>
            ) : (
              <span class="inline-flex items-center gap-2 rounded-lg px-2.5 py-2 text-sm font-semibold text-slate-900">
                {item.title}
              </span>
            )}

            {item.children.length > 0 && (
              <ul class="invisible absolute left-0 top-[calc(100%+8px)] min-w-[220px] translate-y-1 rounded-xl border border-black/10 bg-white p-2 opacity-0 shadow-xl transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {item.children.map((subitem) => (
                  <li>
                    {subitem.url ? (
                      <a
                        href={subitem.url}
                        class="block w-full rounded-lg px-3 py-2 text-sm font-medium text-slate-900 transition hover:bg-slate-900/5"
                      >
                        {subitem.title}
                      </a>
                    ) : (
                      <span class="block w-full rounded-lg px-3 py-2 text-sm font-medium text-slate-900">
                        {subitem.title}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>
