---
import { getMenu, getNewsNewest } from '@/api';
import '@/styles/global.scss';
import Header from '@/components/header/Header.astro';
import Footer from '@/components/Footer.astro';
import NewsLatest from '@/components/NewsLatest.astro';
import Head from '@/components/head/Head.astro';

const [{ header, footer }, { list: newsList }] = await Promise.all([getMenu(), getNewsNewest()]);
---

<!doctype html>
<html lang="ru">
  <Head />

  <body class="ui-container">
    <Header menu={header} />
    <main class="my-pad-md grid grid-cols-12 gap-grid-sm rounded p-pad-sm shadow-lg">
      <NewsLatest
        class="col-span-3"
        list={newsList}
      />
      <div class="col-span-9">
        <slot />
      </div>
    </main>

    <Footer menu={footer} />
  </body>
</html>
