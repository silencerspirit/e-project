---
import type { JSX } from 'astro/jsx-runtime';
import type { TPaginate } from '@contracts';

interface Props extends JSX.HTMLAttributes {
  paginate: TPaginate;
}

const { paginate, ...rest } = Astro.props as Props;
const totalPages = paginate.totalPages;
const currentPage = totalPages > 0 ? Math.min(Math.max(paginate.page, 1), totalPages) : 0;

const buildHref = (targetPage: number): string => {
  const params = new URLSearchParams(Astro.url.searchParams);

  if (targetPage <= 1) {
    params.delete('page');
  } else {
    params.set('page', String(targetPage));
  }

  const query = params.toString();
  const { pathname } = Astro.url;
  return query ? `${pathname}?${query}` : pathname;
};

const buildVisiblePages = (total: number, current: number): number[] => {
  if (total <= 0) {
    return [];
  }

  if (total <= 4) {
    return Array.from({ length: total }, (_, index) => index + 1);
  }

  if (current <= 2) {
    return [1, 2, 3, total];
  }

  if (current === 3) {
    return [1, 2, 3, 4, total];
  }

  if (current >= total - 1) {
    return [1, total - 2, total - 1, total];
  }

  if (current === total - 2) {
    return [1, total - 3, total - 2, total - 1, total];
  }

  return [1, current - 1, current, current + 1, total];
};

const pages = buildVisiblePages(totalPages, currentPage);
const items: (string | number)[] = [];

for (let index = 0; index < pages.length; index += 1) {
  const page = pages[index];
  const previous = pages[index - 1];

  if (index > 0 && previous !== undefined && page - previous > 1) {
    items.push('...');
  }

  items.push(page);
}
---

{
  totalPages > 1 && (
    <nav
      aria-label="Pagination"
      {...rest}
    >
      <ul class="flex gap-grid-xxs">
        {items.map((item) =>
          typeof item === 'string' ? (
            <li aria-hidden="true">{item}</li>
          ) : (
            <li
              class="h5 inline-flex items-center justify-center rounded-full leading-1"
              class:list={{
                'bg-grey-light': item !== currentPage,
                'bg-blue text-white': item === currentPage,
              }}
            >
              {item === currentPage ? (
                <span
                  class="inline-flex h-sz-24 w-sz-24 items-center justify-center"
                  aria-current="page"
                >
                  {item}
                </span>
              ) : (
                <a
                  class="inline-flex h-sz-24 w-sz-24 items-center justify-center"
                  href={buildHref(item)}
                >
                  {item}
                </a>
              )}
            </li>
          ),
        )}
      </ul>
    </nav>
  )
}
