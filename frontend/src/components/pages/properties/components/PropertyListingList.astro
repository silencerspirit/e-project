---
import type { TPropertyListingPageList, TPropertyListingPageQuery } from '@contracts';

import PropertyListingSettings from '@/components/pages/properties/components/PropertyListingSettings.astro';
import Paginate from '@/components/ui/paginate/Paginate.astro';
import PropertyCard from '@/components/ui/property-card/PropertyCard.astro';

import { VIEW_COOKIE_NAME, VIEW_COOKIE_VALUES } from '../properties.consts';

interface Props {
  query: TPropertyListingPageQuery;
  paginate: TPropertyListingPageList['paginate'];
  list: TPropertyListingPageList['list'];
}

const { paginate, query, list } = Astro.props;

const [DEFAULT_VIEW] = VIEW_COOKIE_VALUES;
const initialView = (Astro.cookies.get(VIEW_COOKIE_NAME)?.value ?? DEFAULT_VIEW) as (typeof VIEW_COOKIE_VALUES)[number];
---

<div class="property-listing-list flex min-w-0 flex-1 flex-col gap-8">
  <PropertyListingSettings
    query={query}
    paginate={paginate}
    initialView={initialView}
  />

  <ul
    id="property-listing"
    class="grid grid-cols-1 gap-6"
    class:list={{
      'md:grid-cols-2': true,
      'lg:grid-cols-1': initialView === 'list',
    }}
  >
    {
      list.map((property) => (
        <PropertyCard
          row={initialView === 'list'}
          property={property}
          fullPrice
        />
      ))
    }
  </ul>

  <Paginate paginate={paginate} />
</div>
