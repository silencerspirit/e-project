---
import type { TBadge } from '@contracts';
import type { AstroComponent } from '@lucide/astro';

interface Props {
  list: TBadge[];
  title: string;
  icon: AstroComponent;
  inverse?: boolean;
}

const { list, title, icon: Icon, inverse = false } = Astro.props;
---

<div>
  <h2 class="mb-6 text-2xl font-bold text-foreground">{title}</h2>

  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    {
      list.map((item) => (
        <div class="flex items-center gap-3 rounded-xl border border-border bg-card p-4">
          <div
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg"
            class:list={{ 'bg-primary/10': !inverse, 'bg-secondary': inverse }}
          >
            <Icon
              class="h-4 w-4"
              class:list={{ 'text-muted-foreground': inverse, 'text-primary': !inverse }}
              aria-hidden="true"
            />
          </div>
          <span class="text-sm font-medium text-foreground">{item.value}</span>
        </div>
      ))
    }
  </div>
</div>
