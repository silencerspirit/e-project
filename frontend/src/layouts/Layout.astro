---
import { getMenu, getSiteConfig } from '@/api';
import {
  COOKIE_CONSENT_COOKIE_NAME,
  COOKIE_CONSENT_COOKIE_VALUE,
} from '@/components/ui/cookie-consent/cookie-consent.consts';
import { useAstro } from '@/composables';

import CookieConsent from '@/components/ui/cookie-consent/CookieConsent.astro';
import Footer from '@/components/ui/footer/Footer.astro';
import Head from '@/components/ui/head/Head.astro';
import Header from '@/components/ui/header/Header.astro';

import '@/styles/global.scss';

interface Props {
  canonicalUrl?: string;
  metaDescription?: string;
  metaTitle?: string;
  openGraphImage?: string;
  robots?: string;
  structuredData?: unknown[];
  withSidebar?: boolean;
}

useAstro(Astro);

const { metaTitle, metaDescription, openGraphImage, canonicalUrl, robots, structuredData } = Astro.props;

const [menu, config] = await Promise.all([getMenu(), getSiteConfig()]);
const hasCookieConsent = Astro.cookies.get(COOKIE_CONSENT_COOKIE_NAME)?.value === COOKIE_CONSENT_COOKIE_VALUE;
---

<!doctype html>
<html lang="ru">
  <Head
    title={metaTitle}
    description={metaDescription}
    ogImage={openGraphImage}
    canonical={canonicalUrl}
    robots={robots}
    structuredData={structuredData}
  />

  <body>
    <Header
      menu={menu.header}
      config={config}
    />

    <main class="grow">
      <slot />
    </main>

    <Footer
      config={config}
      menu={menu}
    />
    {!hasCookieConsent && <CookieConsent />}
  </body>
</html>
