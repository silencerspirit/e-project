---
import type { JSX } from 'astro/jsx-runtime';
import { twMerge } from 'tailwind-merge';

interface Props extends JSX.InputHTMLAttributes {}

const { class: className, type = 'text', ...attributes } = Astro.props;

const classes = twMerge(
  'placeholder:text-muted-foreground border-input shadow-xs h-9 w-full border rounded-md px-3 py-1 text-base outline-none transition-colors file:inline-flex disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm',
  'focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-ring focus:ring-ring',
  className,
);
---

<input
  type={type}
  class:list={classes}
  {...attributes}
/>
