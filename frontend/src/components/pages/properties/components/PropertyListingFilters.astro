---
import type { TPropertyListingPageFilters } from '@contracts';
import { X } from '@lucide/astro';

import Button from '@/components/ui/button/Button.astro';

import { FilterCode } from '../properties.enums';
import type { TParsedSegments } from '../properties.types';

interface Props {
  filters: TPropertyListingPageFilters;
  existFilters?: boolean;
  parsedSegments?: TParsedSegments;
}

const { filters, existFilters = false, parsedSegments = {} } = Astro.props;

function formatMillions(price: number): string {
  return `${price / 1_000_000} млн.`;
}
---

<aside
  id="property-listing-filters"
  class="property-listing-filters sticky top-36 z-10 flex w-72 shrink-0 flex-col gap-6 self-start rounded-2xl border border-border bg-card py-6"
  data-exist-filters={JSON.stringify(parsedSegments)}
  aria-labelledby="property-listing-filters-title"
  tabindex="-1"
>
  <div class="flex justify-between px-4">
    <h3
      id="property-listing-filters-title"
      class="text-lg font-semibold text-foreground"
    >
      Фильтры
    </h3>

    <button
      id="property-listing-filters-close"
      type="button"
      class="inline-block xl:hidden"
      aria-label="Закрыть фильтры"
    >
      <X
        aria-hidden="true"
        class="h-4 w-4"
      />
    </button>
  </div>

  <div class="px-4">
    <span class="mb-2 block text-sm font-medium text-foreground">Тип недвижимости</span>
    <div class="flex flex-wrap gap-2">
      <Button
        variant={parsedSegments[FilterCode.PropertyType] ? 'outline' : 'default'}
        data-filter-button
        data-filter-all
        data-type={FilterCode.PropertyType}
      >
        Все объекты
      </Button>

      {
        filters.propertyTypes.map((type) => (
          <Button
            variant={parsedSegments[FilterCode.PropertyType] === type.slug ? 'default' : 'outline'}
            disabled={type.disabled}
            data-filter-button
            data-value={type.slug}
            data-type={FilterCode.PropertyType}
          >
            {type.name}
          </Button>
        ))
      }
    </div>
  </div>
  <div class="px-4">
    <span class="mb-2 block text-sm font-medium text-foreground">Город</span>
    <div class="flex flex-wrap gap-2">
      <Button
        variant={parsedSegments[FilterCode.City] ? 'outline' : 'default'}
        data-filter-button
        data-filter-all
        data-type={FilterCode.City}
      >
        Все города
      </Button>

      {
        filters.cities.map((city) => (
          <Button
            variant={parsedSegments[FilterCode.City] === city.slug ? 'default' : 'outline'}
            disabled={city.disabled}
            data-filter-button
            data-value={city.slug}
            data-type={FilterCode.City}
          >
            {city.name}
          </Button>
        ))
      }
    </div>
  </div>
  <div class="px-4">
    <span class="mb-2 block text-sm font-medium text-foreground">Бюджет</span>
    <div class="flex flex-wrap gap-2">
      <Button
        variant={parsedSegments[FilterCode.PriceFrom] || parsedSegments[FilterCode.PriceTo] ? 'outline' : 'default'}
        data-filter-button
        data-filter-all
        data-type={FilterCode.PriceFrom}
      >
        Любая цена
      </Button>

      {
        filters.prices.map((price, i) => {
          const textMap = {
            0: `до ${formatMillions(price.to)}`,
            1: `от ${formatMillions(price.from)} до ${formatMillions(price.to)}`,
            2: `от ${formatMillions(price.from)}`,
          };

          const priceForm = Number(parsedSegments[FilterCode.PriceFrom]);
          const priceTo = Number(parsedSegments[FilterCode.PriceTo]);

          const buttonVariant = () => {
            if (price.disabled) return 'outline';

            if (price.from === priceForm && price.to === priceTo) return 'default';

            return 'outline';
          };

          return (
            <Button
              variant={buttonVariant()}
              data-filter-button
              disabled={price.disabled}
              data-from={price.from}
              data-to={price.to}
              data-type={FilterCode.PriceFrom}
            >
              {textMap[i as keyof typeof textMap]}
            </Button>
          );
        })
      }
    </div>
  </div>

  <div class="mt-auto flex flex-col gap-2 px-4">
    <Button
      id="property-listing-filters-submit"
      type="button"
      class="hidden"
    />

    <Button
      variant="outline"
      href="/properties/"
      class:list={{
        hidden: !existFilters,
      }}
    >
      <X
        aria-hidden="true"
        class="h-4 w-4 text-foreground"
      />
      Сбросить фильтры
    </Button>
  </div>
</aside>

<style lang="scss">
  @use '@/styles/mixins.scss' as *;

  .property-listing-filters {
    transition:
      transform 0.3s ease,
      visibility 0s linear 0.3s;

    @include hide-scrollbar-but-scrolling();

    @media (max-width: calc(#{theme('screens.xl')} - 1px)) {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      border-radius: 0;
      overflow-y: auto;
      min-height: 100vh;
      padding-top: theme('spacing.2');
      z-index: 99;
      transform: translateX(-100%);
      visibility: hidden;
    }

    @media (max-width: calc(#{theme('screens.sm')} - 1px)) {
      width: 100%;
    }

    &--active {
      transform: translateX(0);
      visibility: visible;
      transition-delay: 0s;
    }
  }
</style>
