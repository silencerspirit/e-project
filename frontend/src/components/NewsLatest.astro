---
import type { TNewsListItem } from '@contracts';

import { ArrowRightIcon } from '@/assets/icons';

import Datetime from '@/components/ui/datetime/Datetime.astro';

interface Props {
  list: TNewsListItem[];
  class?: string;
}

const { list, class: className = '' } = Astro.props as Props;
---

<aside class={`${className} bg-grey-light rounded flex flex-col p-pad-md gap-grid-md self-start`}>
  <div class="flex flex-col">
    <h2 class="h1 font-bold uppercase">Новости</h2>
    <h3 class="h4 font-semibold uppercase text-red">Новости компании</h3>
  </div>

  <ul class="flex flex-col gap-grid-xxs">
    {
      list.map((item, i) => (
        <li
          class="flex flex-col"
          class:list={{
            'border-t border-white pt-grid-xxs': i > 0,
          }}
        >
          <article class="flex flex-col">
            <div class="inline-flex items-center">
              <a
                href={`/news/${item.slug}/`}
                class="line-clamp-1 transition-colors hover:text-red"
                aria-label={`Новость: ${item.title}`}
              >
                {item.title}
              </a>

              <Datetime datetime={item.publishedDate} />
            </div>

            <p class="h5 line-clamp-2">{item.shortDescription}</p>
          </article>
        </li>
      ))
    }
  </ul>

  <a
    href="/news/"
    class="h4 inline-flex items-center gap-grid-3xs self-end font-bold transition-colors hover:text-red"
  >
    Читать все новости
    <ArrowRightIcon class="h-sz-14" />
  </a>
</aside>
