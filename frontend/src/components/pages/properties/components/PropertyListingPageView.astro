---
import { type TPropertyListingPage, type TPropertyListingPageList, type TPropertyListingPageQuery } from '@contracts';
import { X } from '@lucide/astro';

import {
  buildCanonicalUrl,
  buildPaginatedDescription,
  buildPaginatedTitle,
} from '@/components/ui/paginate/paginate.utils';
import { getPublicSiteUrl } from '@/helpers';

import PropertyListingFilters from '@/components/pages/properties/components/PropertyListingFilters.astro';
import Breadcrumbs from '@/components/ui/breadcrumbs/Breadcrumbs.astro';
import Button from '@/components/ui/button/Button.astro';
import Layout from '@/layouts/Layout.astro';

import type { TParsedSegments } from '../properties.types';

import PropertyListingList from './PropertyListingList.astro';

interface Props {
  info: TPropertyListingPage;
  listing: TPropertyListingPageList;
  parsedSegments?: TParsedSegments;
  query: TPropertyListingPageQuery;
}

const { info, listing, parsedSegments = {}, query } = Astro.props;
const { list, paginate, filters } = listing;

const isEmptyList: boolean = !list.length;
const existFilters: boolean = Object.values(parsedSegments).filter(Boolean).length > 0;
const siteUrl = getPublicSiteUrl(Astro.url);

const metaTitle: string = buildPaginatedTitle(info.seo?.metaTitle ?? info.title, paginate.page);
const metaDescription: string = buildPaginatedDescription(info.seo?.metaDescription ?? info.description, paginate.page);
const canonicalUrl: string = buildCanonicalUrl(Astro.url, paginate.page, siteUrl);
---

<Layout
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  canonicalUrl={canonicalUrl}
>
  <Breadcrumbs
    title={info.title}
    description={info.description}
  />

  <section class="property-listing-page-view py-12 lg:py-16">
    <div class="relative mx-auto flex max-w-7xl flex-row px-4 sm:px-6 lg:px-8 xl:gap-10">
      {
        isEmptyList ? (
          <div class="flex w-full flex-col items-center gap-6">
            <p class="text-center text-sm text-muted-foreground">Ничего не найдено, попробуйте:</p>

            <Button
              variant="outline"
              href="/properties/"
            >
              <X
                aria-hidden="true"
                class="h-4 w-4 text-foreground"
              />
              Сбросить фильтры
            </Button>
          </div>
        ) : (
          <>
            <PropertyListingFilters
              filters={filters}
              existFilters={existFilters}
              parsedSegments={parsedSegments}
            />

            <PropertyListingList
              query={query}
              list={list}
              paginate={paginate}
            />
          </>
        )
      }
    </div>
  </section>
</Layout>

<script src="./property-listing-page-view.ts"></script>
