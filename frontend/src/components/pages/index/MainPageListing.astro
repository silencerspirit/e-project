---
import type { TShowcaseBanner } from '@contracts';
import { ArrowLeft, ArrowRight } from '@lucide/astro';

import Button from '@/components/ui/button/Button.astro';
import PropertyCard from '@/components/ui/property-card/PropertyCard.astro';

interface Props {
  info: TShowcaseBanner;
}

const { info } = Astro.props;

const sectionId = `main-page-listing-${Math.random().toString(36).slice(2)}`;

const propertyTypes: string[] = [
  ...new Set(info.properties.map((property) => property.propertyType?.name ?? '').filter(Boolean)),
];
const DEFAULT_FILTER_VALUE = 'Все';
const filters = [DEFAULT_FILTER_VALUE, ...propertyTypes] as const;
---

<section
  id={sectionId}
  class="main-page-listing bg-background py-20 lg:py-28"
  aria-labelledby="main-page-listing-title"
  data-main-page-listing
  data-default-filter-value={DEFAULT_FILTER_VALUE}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6">
      <div class="w-full">
        <h2
          id="main-page-listing-title"
          class="text-balance text-3xl font-bold text-foreground sm:text-4xl"
        >
          {info.title}
        </h2>
        <p class="mt-4 text-lg text-muted-foreground">{info.description}</p>
      </div>

      <div class="flex items-start gap-6">
        <div
          class="flex w-full flex-wrap gap-2"
          role="group"
          aria-label="Фильтр объектов по типу"
        >
          {
            filters.map((filter) => (
              <Button
                data-listing-filter
                data-filter={filter}
                class="rounded-full"
                aria-pressed={filter === DEFAULT_FILTER_VALUE ? 'true' : 'false'}
                variant={filter === DEFAULT_FILTER_VALUE ? 'default' : 'outline'}
              >
                {filter}
              </Button>
            ))
          }
        </div>

        <div class="hidden gap-4 lg:flex">
          <Button
            variant="link"
            aria-label="Предыдущей слайд"
            id="slider-prev-button"
            class="text-primary transition-colors hover:bg-primary/10"
          >
            <ArrowLeft
              aria-hidden="true"
              class="h-4 w-4"
            />
          </Button>
          <Button
            variant="link"
            aria-label="Следующий слайд"
            id="slider-next-button"
            class="text-primary transition-colors hover:bg-primary/10"
          >
            <ArrowRight
              aria-hidden="true"
              class="h-4 w-4"
            />
          </Button>
        </div>
      </div>
    </div>

    <div
      class="swiper main-page-listing__slider"
      data-listing-slider
    >
      <div
        class="swiper-wrapper items-stretch"
        data-listing-swiper-wrapper
      >
        {
          info.properties.map((property) => (
            <ul
              class="swiper-slide flex"
              data-type={property.propertyType?.name ?? ''}
            >
              <PropertyCard property={property} />
            </ul>
          ))
        }
      </div>
    </div>

    <div class="text-center">
      <Button
        href="/properties/"
        variant="outline"
        size="lg"
        class="border-primary bg-transparent text-primary hover:bg-primary hover:text-primary-foreground"
      >
        Смотреть все объекты
        <ArrowRight
          aria-hidden="true"
          class="h-4 w-4"
        />
      </Button>
    </div>
  </div>
</section>

<style lang="scss">
  .main-page-listing {
    &__slider {
      @apply px-4 py-10;

      margin-inline: calc(#{theme('size.4')} * -1);
      width: calc(100% + #{theme('size.4')} * 2);

      .swiper-slide {
        max-width: calc((100% - #{theme('size.6')} * 2) / 3);
        height: auto;

        @media (max-width: theme('screens.lg')) {
          max-width: calc((100% - #{theme('size.4')}));
        }

        &:not(:last-child) {
          margin-right: theme('size.6');

          @media (max-width: theme('screens.lg')) {
            margin-right: theme('size.4');
          }
        }
      }
    }
  }
</style>

<script src="./main-page-listing.ts"></script>
