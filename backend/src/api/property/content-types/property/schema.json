{
  "kind": "collectionType",
  "collectionName": "properties",
  "info": {
    "singularName": "property",
    "pluralName": "properties",
    "displayName": "Property"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "priceFrom": {
      "type": "decimal",
      "required": true
    },
    "pricePerM2": {
      "type": "decimal",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "shortDescription": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "previewImage": {
      "type": "component",
      "component": "shared.images",
      "repeatable": false,
      "required": true
    },
    "city": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::city.city",
      "inversedBy": "properties"
    },
    "propertyType": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::property-type.property-type",
      "inversedBy": "properties"
    },
    "badges": {
      "type": "component",
      "component": "shared.badge",
      "repeatable": true
    },
    "images": {
      "type": "component",
      "component": "shared.images",
      "repeatable": true
    },
    "specifications": {
      "type": "component",
      "component": "shared.spec-item",
      "repeatable": true
    },
    "techSpecifications": {
      "type": "component",
      "component": "shared.spec-item",
      "repeatable": true
    },
    "activityTypes": {
      "type": "component",
      "component": "shared.badge",
      "repeatable": true
    },
    "infrastructure": {
      "type": "component",
      "component": "shared.badge",
      "repeatable": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "latitude": {
      "type": "float"
    },
    "longitude": {
      "type": "float"
    }
  }
}
