---
import { getMainPage, getMainPageForm } from '@/api';
import MainPageAdvantages from '@/components/pages/index/MainPageAdvantages.vue';
import MainPageBanner from '@/components/pages/index/MainPageBanner.vue';
import MainPageCategories from '@/components/pages/index/MainPageCategories.vue';
import MainPageListing from '@/components/pages/index/MainPageListing.vue';
import VueRequestSection from '@/components/vue/VueRequestSection.vue';
import { createOrganizationSchema, createWebSiteSchema, getPublicSiteUrl } from '@/helpers';

import Layout from '@/layouts/Layout.astro';

const [page, form] = await Promise.all([getMainPage(), getMainPageForm()]);

const metaTitle: string = page.seo?.metaTitle ?? '';
const metaDescription: string = page.seo?.metaDescription ?? '';
const siteUrl = getPublicSiteUrl(Astro.url);
const organizationSchema = createOrganizationSchema(siteUrl);
const webSiteSchema = createWebSiteSchema(siteUrl);
---

<Layout
  metaTitle={metaTitle}
  metaDescription={metaDescription}
  structuredData={[organizationSchema, webSiteSchema]}
>
  {
    page.heroBanner && (
      <MainPageBanner
        client:load
        info={page.heroBanner}
        form={form}
      />
    )
  }

  {page.featureBanner && <MainPageCategories info={page.featureBanner} />}

  {
    page.showcaseBanner && (
      <MainPageListing
        client:visible
        info={page.showcaseBanner}
      />
    )
  }

  {page.advantagesBanner && <MainPageAdvantages info={page.advantagesBanner} />}

  {
    page.requestBanner && (
      <VueRequestSection
        info={page.requestBanner}
        client:visible
      />
    )
  }
</Layout>
