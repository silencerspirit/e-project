---
import { CircleCheck, Phone, SendHorizontal } from '@lucide/astro';

import Button from '@/components/ui/button/Button.astro';
import Input from '@/components/ui/input/Input.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class="rounded-2xl border border-border bg-card p-6 shadow-sm lg:p-8"
  data-property-form-root
>
  <div data-property-form-form-wrap>
    <h3 class="mb-2 text-xl font-bold text-foreground">Узнать подробнее</h3>
    <p class="mb-6 text-sm text-muted-foreground">
      Оставьте заявку, и наш специалист расскажет всё о {title}
    </p>

    <form
      class="space-y-4"
      data-property-form-form
    >
      <div>
        <label
          for="property-contact-name"
          class="mb-2 block text-sm font-medium text-foreground"
        >
          Ваше имя
        </label>
        <Input
          id="property-contact-name"
          type="text"
          placeholder="Иван Петров"
          class="py-5"
          required
          autocomplete="name"
          data-property-form-name
        />
      </div>

      <div>
        <label
          for="property-contact-phone"
          class="mb-2 block text-sm font-medium text-foreground"
        >
          Телефон
        </label>
        <div class="relative">
          <Phone
            class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
            aria-hidden="true"
          />
          <Input
            id="property-contact-phone"
            type="tel"
            placeholder="+7 (___) ___-__-__"
            data-maska="+7 (###) ###-##-##"
            class="py-5 pl-11"
            required
            autocomplete="tel"
            data-property-form-phone
          />
        </div>
      </div>

      <Button
        type="submit"
        class="h-12 w-full bg-primary font-medium text-primary-foreground hover:bg-primary/90"
      >
        <SendHorizontal
          class="mr-2 h-4 w-4"
          aria-hidden="true"
        />
        Отправить заявку
      </Button>

      <p class="text-center text-xs text-muted-foreground">
        Нажимая кнопку, вы соглашаетесь с обработкой персональных данных
      </p>
    </form>
  </div>

  <div
    class="hidden py-6 text-center"
    data-property-form-success
    aria-live="polite"
  >
    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-green-100">
      <CircleCheck
        class="h-7 w-7 text-green-600"
        aria-hidden="true"
      />
    </div>
    <h3 class="mb-2 text-xl font-semibold text-foreground">Заявка отправлена!</h3>
    <p class="text-sm text-muted-foreground">Мы свяжемся с вами в ближайшее время</p>
  </div>
</div>

<script src="./property-detail-form.ts"></script>
