---
import type { SpecItemType, TSpecItem } from '@contracts';
import { CircleAlert } from '@lucide/astro';

import { SPEC_ICON_MAP } from '@/components/ui/property-card/property-card.consts';
interface Props {
  techSpecification: TSpecItem[];
}

const { techSpecification } = Astro.props;
---

<div class="mt-6 rounded-2xl border border-border bg-card p-6">
  <h4 class="mb-4 font-semibold text-foreground">Технические характеристики</h4>

  <div class="space-y-4">
    {
      techSpecification.map((item) => {
        const Icon = SPEC_ICON_MAP[item.key as SpecItemType] ?? CircleAlert;
        return (
          <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10">
              <Icon
                class="h-4 w-4 text-primary"
                aria-hidden="true"
              />
            </div>
            <div>
              <p class="text-sm font-medium text-foreground">{item.label}</p>
              <p class="mt-0.5 text-xs text-muted-foreground">{item.value}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</div>
